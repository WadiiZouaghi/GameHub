{% extends 'base.html.twig' %}

{% block title %}Register - GameHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('.auth-form');
            const password1 = document.getElementById('registration_form_password_first');
            const password2 = document.getElementById('registration_form_password_second');

            if (password1 && password2) {
                form.addEventListener('submit', function(e) {
                    if (password1.value !== password2.value) {
                        e.preventDefault();
                        alert('Passwords do not match. Please try again.');
                        password2.focus();
                        return false;
                    }
                });
            }
        });
    </script>
{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="particles-bg">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>
    
    <div class="grid-overlay"></div>
    
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-form-side">
                <div class="form-content">
                    <div class="auth-header">
                        <h1 class="auth-title font-orbitron">Join GameHub</h1>
                        <p class="auth-subtitle">Create your account and start gaming</p>
                    </div>

                    {{ form_start(registrationForm, {'attr': {'class': 'auth-form', 'data-turbo': 'false'}}) }}
                        <div class="auth-form-group">
                            {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'auth-label'}}) }}
                            <div class="input-wrapper">
                                {{ form_widget(registrationForm.username, {'attr': {'class': 'auth-input', 'placeholder': 'Choose a username'}}) }}
                                <div class="input-glow"></div>
                            </div>
                            <div class="auth-error">{{ form_errors(registrationForm.username) }}</div>
                        </div>

                        <div class="auth-form-group">
                            {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'auth-label'}}) }}
                            <div class="input-wrapper">
                                {{ form_widget(registrationForm.email, {'attr': {'class': 'auth-input', 'placeholder': 'Enter your email'}}) }}
                                <div class="input-glow"></div>
                            </div>
                            <div class="auth-error">{{ form_errors(registrationForm.email) }}</div>
                        </div>

                        <div class="auth-form-group">
                            {{ form_label(registrationForm.password.first, 'Password', {'label_attr': {'class': 'auth-label'}}) }}
                            <div class="input-wrapper">
                                {{ form_widget(registrationForm.password.first, {'attr': {'class': 'auth-input', 'placeholder': 'Create a strong password'}}) }}
                                <div class="input-glow"></div>
                            </div>
                            <div class="auth-error">{{ form_errors(registrationForm.password.first) }}</div>
                        </div>

                        <div class="auth-form-group">
                            {{ form_label(registrationForm.password.second, 'Confirm Password', {'label_attr': {'class': 'auth-label'}}) }}
                            <div class="input-wrapper">
                                {{ form_widget(registrationForm.password.second, {'attr': {'class': 'auth-input', 'placeholder': 'Re-enter your password'}}) }}
                                <div class="input-glow"></div>
                            </div>
                            <div class="auth-error">{{ form_errors(registrationForm.password.second) }}</div>
                        </div>

                        <button class="auth-btn auth-btn-primary" type="submit">
                            <span class="btn-text">
                                <i class="fas fa-user-plus"></i>
                                Create Account
                            </span>
                            <div class="btn-glow"></div>
                        </button>

                        <div class="auth-divider">
                            <span>OR CONTINUE WITH</span>
                        </div>

                        <a href="{{ path('connect_google_start') }}" class="auth-btn auth-btn-google">
                            <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                <path fill="none" d="M0 0h48v48H0z"/>
                            </svg>
                            Sign up with Google
                        </a>
                    {{ form_end(registrationForm) }}

                    <div class="auth-footer">
                        <p>Already have an account? <a href="{{ path('app_login') }}" class="auth-link">Sign in</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
}

.auth-wrapper {
    position: relative;
    width: 100vw;
    min-height: 100vh;

    /* BREAK OUT of any parent constraints */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);

    padding: 0;
}

.auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
    position: relative;
    overflow: hidden;
}

.particles-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: hsl(var(--primary));
    border-radius: 50%;
    box-shadow: 0 0 10px hsl(var(--primary));
    animation: float 20s infinite;
    opacity: 0.6;
}

.particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; animation-duration: 15s; }
.particle:nth-child(2) { left: 20%; top: 80%; animation-delay: 2s; animation-duration: 18s; }
.particle:nth-child(3) { left: 50%; top: 10%; animation-delay: 4s; animation-duration: 22s; }
.particle:nth-child(4) { left: 80%; top: 30%; animation-delay: 6s; animation-duration: 20s; }
.particle:nth-child(5) { left: 30%; top: 50%; animation-delay: 1s; animation-duration: 16s; }
.particle:nth-child(6) { left: 70%; top: 70%; animation-delay: 3s; animation-duration: 19s; }
.particle:nth-child(7) { left: 90%; top: 50%; animation-delay: 5s; animation-duration: 21s; }
.particle:nth-child(8) { left: 60%; top: 90%; animation-delay: 7s; animation-duration: 17s; }
.particle:nth-child(9) { left: 15%; top: 40%; animation-delay: 1.5s; animation-duration: 19s; }
.particle:nth-child(10) { left: 85%; top: 15%; animation-delay: 3.5s; animation-duration: 16s; }
.particle:nth-child(11) { left: 40%; top: 75%; animation-delay: 2.5s; animation-duration: 21s; }
.particle:nth-child(12) { left: 65%; top: 25%; animation-delay: 4.5s; animation-duration: 18s; }
.particle:nth-child(13) { left: 25%; top: 60%; animation-delay: 0.5s; animation-duration: 20s; }
.particle:nth-child(14) { left: 75%; top: 45%; animation-delay: 6.5s; animation-duration: 17s; }
.particle:nth-child(15) { left: 45%; top: 35%; animation-delay: 1.8s; animation-duration: 22s; }
.particle:nth-child(16) { left: 55%; top: 65%; animation-delay: 3.2s; animation-duration: 19s; }
.particle:nth-child(17) { left: 12%; top: 85%; animation-delay: 5.5s; animation-duration: 18s; }
.particle:nth-child(18) { left: 88%; top: 55%; animation-delay: 2.2s; animation-duration: 20s; }
.particle:nth-child(19) { left: 35%; top: 15%; animation-delay: 4.8s; animation-duration: 16s; }
.particle:nth-child(20) { left: 72%; top: 82%; animation-delay: 0.8s; animation-duration: 21s; }
.particle:nth-child(21) { left: 18%; top: 32%; animation-delay: 6.2s; animation-duration: 17s; }
.particle:nth-child(22) { left: 82%; top: 68%; animation-delay: 1.3s; animation-duration: 19s; }
.particle:nth-child(23) { left: 48%; top: 48%; animation-delay: 3.8s; animation-duration: 22s; }
.particle:nth-child(24) { left: 62%; top: 12%; animation-delay: 5.2s; animation-duration: 18s; }
.particle:nth-child(25) { left: 28%; top: 72%; animation-delay: 2.8s; animation-duration: 20s; }
.particle:nth-child(26) { left: 78%; top: 38%; animation-delay: 4.2s; animation-duration: 16s; }
.particle:nth-child(27) { left: 38%; top: 88%; animation-delay: 0.3s; animation-duration: 21s; }
.particle:nth-child(28) { left: 92%; top: 22%; animation-delay: 6.8s; animation-duration: 17s; }
.particle:nth-child(29) { left: 22%; top: 52%; animation-delay: 1.2s; animation-duration: 19s; }
.particle:nth-child(30) { left: 52%; top: 78%; animation-delay: 3.6s; animation-duration: 22s; }
.particle:nth-child(31) { left: 68%; top: 42%; animation-delay: 5.8s; animation-duration: 18s; }
.particle:nth-child(32) { left: 42%; top: 58%; animation-delay: 2.4s; animation-duration: 20s; }

@keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(20px, -30px) scale(1.2); }
    50% { transform: translate(-20px, -60px) scale(0.8); }
    75% { transform: translate(30px, -40px) scale(1.1); }
}

.grid-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: 
        linear-gradient(hsl(var(--primary) / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--primary) / 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
}

@keyframes gridMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
}

.auth-container {
    width: 100%;
    max-width: 420px;
    position: relative;
    z-index: 1;
}

.auth-card {
    background: linear-gradient(135deg, rgba(26, 31, 58, 0.95) 0%, rgba(15, 18, 35, 0.95) 100%);
    border: 1px solid hsl(var(--primary) / 0.3);
    border-radius: 1rem;
    box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 40px hsl(var(--primary) / 0.15),
        inset 0 1px 0 hsl(var(--primary) / 0.2);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(20px);
}

.auth-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--secondary)), hsl(var(--primary)));
    background-size: 200% 100%;
    animation: shimmer 3s infinite;
}

@keyframes shimmer {
    0%, 100% { background-position: 0% 0%; }
    50% { background-position: 100% 0%; }
}

.auth-form-side {
    padding: 2rem;
}

.form-content {
    width: 100%;
}

.auth-header {
    margin-bottom: 1.5rem;
    text-align: center;
}

.auth-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: hsl(var(--foreground));
    margin-bottom: 0.25rem;
    letter-spacing: 0.5px;
}

.auth-subtitle {
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    font-family: 'Rajdhani', sans-serif;
}

.auth-form {
    margin-top: 1.5rem;
}

.auth-form-group {
    margin-bottom: 1rem;
    position: relative;
}

.auth-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin-bottom: 0.5rem;
    font-family: 'Rajdhani', sans-serif;
}

.input-wrapper {
    position: relative;
}

.auth-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    color: hsl(var(--foreground));
    font-size: 0.9rem;
    font-family: 'Rajdhani', sans-serif;
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
}

.auth-input:focus {
    outline: none;
    border-color: hsl(var(--primary));
    background: rgba(255, 255, 255, 0.05);
}

.auth-input:focus ~ .input-glow {
    opacity: 1;
}

.input-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 0.5rem;
    box-shadow: 0 0 15px hsl(var(--primary) / 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.auth-input::placeholder {
    color: hsl(var(--muted-foreground));
}

.auth-error {
    color: hsl(var(--destructive));
    font-size: 0.8rem;
    margin-top: 0.375rem;
    font-family: 'Rajdhani', sans-serif;
}

.auth-error ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.auth-error li {
    margin-top: 0.25rem;
}

.auth-btn {
    width: 100%;
    padding: 0.875rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: 'Rajdhani', sans-serif;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-top: 1.25rem;
    position: relative;
    overflow: hidden;
}

.auth-btn-primary {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--secondary)));
    color: white;
    box-shadow: 0 4px 15px hsl(var(--primary) / 0.4);
}

.auth-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px hsl(var(--primary) / 0.5);
}

.auth-btn-primary .btn-text {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: btnShine 3s infinite;
}

@keyframes btnShine {
    0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
    100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
}

.auth-divider {
    position: relative;
    text-align: center;
    margin: 1.25rem 0;
}

.auth-divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, hsl(var(--border)), transparent);
}

.auth-divider span {
    position: relative;
    background: linear-gradient(135deg, rgba(26, 31, 58, 0.95), rgba(15, 18, 35, 0.95));
    padding: 0 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.auth-btn-google {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    backdrop-filter: blur(10px);
}

.auth-btn-google:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: hsl(var(--primary));
    transform: translateY(-2px);
}

.auth-footer {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid hsl(var(--border) / 0.5);
}

.auth-footer p {
    color: hsl(var(--muted-foreground));
    font-size: 0.85rem;
    font-family: 'Rajdhani', sans-serif;
}

.auth-link {
    color: hsl(var(--primary));
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
}

.auth-link:hover {
    color: hsl(var(--secondary));
    text-decoration: underline;
}

@media (max-width: 640px) {
    .auth-wrapper {
        padding: 1rem;
    }
    
    .auth-form-side {
        padding: 2rem 1.5rem;
    }
    
    .auth-title {
        font-size: 2rem;
    }
}
</style>
{% endblock %}
