{% extends 'base.html.twig' %}

{% block title %}My Library{% endblock %}

{% block body %}
<div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-24">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div class="mb-12 flex items-center justify-between">
                <div>
                    <h1 class="font-orbitron text-3xl font-bold text-foreground mb-2">My Library</h1>
                    <p class="text-muted-foreground font-rajdhani">{{ purchases|length }} {{ purchases|length == 1 ? 'game' : 'games' }}</p>
                </div>
                
                {% if purchases is not empty %}
                    <div class="flex gap-2">
                        <button id="gridViewBtn" class="px-4 py-2 rounded-lg bg-primary/10 text-primary border border-primary/20 font-rajdhani transition-colors">
                            <i class="fas fa-th"></i>
                        </button>
                        <button id="listViewBtn" class="px-4 py-2 rounded-lg hover:bg-muted text-muted-foreground border border-border font-rajdhani transition-colors">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                {% endif %}
            </div>

            {% if purchases is empty %}
                <!-- Empty State -->
                <div class="text-center py-20">
                    <i class="fas fa-gamepad text-6xl text-muted-foreground/30 mb-6"></i>
                    <h2 class="font-orbitron text-2xl font-bold text-foreground mb-3">No games yet</h2>
                    <p class="text-muted-foreground font-rajdhani mb-8">Start building your collection</p>
                    <a href="{{ path('game_index') }}" class="btn-hero inline-flex items-center gap-2">
                        <i class="fas fa-store"></i>
                        Browse Games
                    </a>
                </div>
            {% else %}
                <!-- Games Grid -->
                <div id="gridView" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    {% for purchase in purchases %}
                        <div class="group">
                            <!-- Game Cover -->
                            <a href="{{ path('game_show', {'id': purchase.game.id}) }}" class="block relative aspect-[3/4] rounded-lg overflow-hidden bg-card border border-border/50 hover:border-primary/50 transition-all mb-3">
                                {% if purchase.game.coverImage %}
                                    <img src="{{ asset(purchase.game.coverImage) }}" 
                                         alt="{{ purchase.game.title }}" 
                                         class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full bg-muted flex items-center justify-center">
                                        <i class="fas fa-gamepad text-4xl text-muted-foreground/40"></i>
                                    </div>
                                {% endif %}
                                
                                <!-- Hover Overlay -->
                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                    <i class="fas fa-play text-white text-2xl"></i>
                                </div>
                            </a>

                            <!-- Game Info -->
                            <div class="space-y-2">
                                <h3 class="font-rajdhani font-semibold text-foreground text-sm line-clamp-2 leading-tight">
                                    {{ purchase.game.title }}
                                </h3>
                                
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-xs text-muted-foreground font-rajdhani">
                                        {{ purchase.game.category }}
                                    </span>
                                    <button onclick="confirmDelete({{ purchase.id }}, '{{ purchase.game.title|e('js') }}')" 
                                            class="text-muted-foreground hover:text-destructive transition-colors"
                                            title="Remove from library">
                                        <i class="fas fa-trash text-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Games List -->
                <div id="listView" class="hidden space-y-2">
                    {% for purchase in purchases %}
                        <div class="group bg-card border border-border/50 hover:border-primary/30 rounded-lg p-4 transition-all">
                            <div class="flex items-center gap-4">
                                <!-- Thumbnail -->
                                <a href="{{ path('game_show', {'id': purchase.game.id}) }}" class="flex-shrink-0">
                                    <div class="w-20 h-28 rounded-lg overflow-hidden bg-muted border border-border/30">
                                        {% if purchase.game.coverImage %}
                                            <img src="{{ asset(purchase.game.coverImage) }}" 
                                                 alt="{{ purchase.game.title }}" 
                                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center">
                                                <i class="fas fa-gamepad text-2xl text-muted-foreground/40"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                </a>

                                <!-- Game Info -->
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-rajdhani font-bold text-foreground text-lg mb-1 truncate">
                                        {{ purchase.game.title }}
                                    </h3>
                                    <div class="flex items-center gap-4 text-sm text-muted-foreground font-rajdhani">
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-tag text-xs"></i>
                                            {{ purchase.game.category }}
                                        </span>
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-calendar text-xs"></i>
                                            {{ purchase.purchaseDate|date('M d, Y') }}
                                        </span>
                                        <span class="flex items-center gap-1.5">
                                            <i class="fas fa-dollar-sign text-xs"></i>
                                            {{ purchase.game.price|number_format(2) }}
                                        </span>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex items-center gap-3">
                                    <button onclick="confirmDelete({{ purchase.id }}, '{{ purchase.game.title|e('js') }}')" 
                                            class="px-4 py-2 rounded-lg hover:bg-destructive/10 text-muted-foreground hover:text-destructive border border-border hover:border-destructive/30 transition-colors"
                                            title="Remove from library">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="bg-card max-w-md w-full rounded-xl border border-border p-6">
        <h3 class="font-orbitron text-xl font-bold text-foreground mb-3">Remove from Library?</h3>
        <p class="text-muted-foreground font-rajdhani mb-6">
            Are you sure you want to remove <span id="gameName" class="text-foreground font-semibold"></span> from your library?
        </p>
        
        <div class="flex gap-3">
            <button onclick="closeModal()" class="flex-1 px-4 py-2 rounded-lg border border-border text-foreground hover:bg-muted transition-colors font-rajdhani">
                Cancel
            </button>
            <form id="deleteForm" method="post" class="flex-1">
                <button type="submit" class="w-full px-4 py-2 rounded-lg bg-destructive hover:bg-destructive/80 text-destructive-foreground font-rajdhani transition-colors">
                    Remove
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('deleteModal');

    window.confirmDelete = (id, name) => {
        document.getElementById('gameName').textContent = name;
        document.getElementById('deleteForm').action = '{{ path('library_remove', {'id': '__ID__'}) }}'.replace('__ID__', id);
        modal.classList.replace('hidden', 'flex');
    };

    window.closeModal = () => modal.classList.replace('flex', 'hidden');

    modal.addEventListener('click', e => e.target.id === 'deleteModal' && closeModal());
    document.addEventListener('keydown', e => e.key === 'Escape' && closeModal());

    const [gridBtn, listBtn, gridView, listView] = ['gridViewBtn', 'listViewBtn', 'gridView', 'listView'].map(id => document.getElementById(id));

    if (gridBtn && listBtn) {
        const activeClasses = ['bg-primary/10', 'text-primary', 'border-primary/20'];
        const inactiveClasses = ['hover:bg-muted', 'text-muted-foreground', 'border-border'];
        
        const toggleView = (show, hide, activeBtn, inactiveBtn) => {
            show.classList.remove('hidden');
            hide.classList.add('hidden');
            activeBtn.classList.add(...activeClasses);
            activeBtn.classList.remove(...inactiveClasses);
            inactiveBtn.classList.remove(...activeClasses);
            inactiveBtn.classList.add(...inactiveClasses);
        };

        gridBtn.addEventListener('click', () => toggleView(gridView, listView, gridBtn, listBtn));
        listBtn.addEventListener('click', () => toggleView(listView, gridView, listBtn, gridBtn));
    }
</script>
{% endblock %}
