{% extends 'admin.html.twig' %}

{% block title %}Edit User - GameHub Admin{% endblock %}

{% block content %}
    <div class="admin-header" style="margin-bottom: 2rem;">
        <div class="admin-welcome" style="display: flex; align-items: center; gap: 1rem;">
            <div class="admin-avatar" style="width: 50px; height: 50px; background: hsl(var(--primary) / 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-user-edit" style="color: hsl(var(--primary)); font-size: 1.5rem;"></i>
            </div>
            <div class="welcome-content">
                <h1 style="font-family: 'Orbitron', sans-serif; font-size: 1.75rem; font-weight: 700; color: hsl(var(--foreground)); margin: 0;">Edit User</h1>
                <p style="color: hsl(var(--muted-foreground)); margin: 0.25rem 0 0 0;">Update user details and permissions</p>
            </div>
        </div>
    </div>

            <div class="admin-section">
                <div class="section-header">
                    <h2>
                        <i class="fas fa-user-edit"></i>
                        User Details
                    </h2>
                    <a href="{{ path('admin_users') }}" class="btn btn-secondary btn-small">
                        <i class="fas fa-arrow-left"></i>
                        Back to Users
                    </a>
                </div>

                {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
                    <div class="form-grid">
                        <div class="form-group">
                            {{ form_label(form.username) }}
                            {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.username) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.email) }}
                        </div>

                        <div class="form-group form-group-full">
                            {{ form_label(form.bio) }}
                            {{ form_widget(form.bio, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                            {{ form_errors(form.bio) }}
                        </div>

                        <div class="form-group form-group-full">
                            {{ form_label(form.roles) }}
                            <div class="roles-container">
                                {{ form_widget(form.roles, {'attr': {'class': 'form-control roles-select'}}) }}
                                <div class="roles-info">
                                    <small>Hold Ctrl/Cmd to select multiple roles</small>
                                </div>
                            </div>
                            {{ form_errors(form.roles) }}
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            Save Changes
                        </button>
                        <a href="{{ path('admin_users') }}" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>

<style>
.admin-form {
    max-width: none;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.form-group-full {
    grid-column: 1 / -1;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: hsl(var(--foreground));
    font-weight: 600;
    font-size: 0.9rem;
    font-family: 'Rajdhani', sans-serif;
}

.form-control {
    width: 100%;
    background: hsl(var(--input));
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    color: hsl(var(--foreground));
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
    transition: all 0.2s ease;
}

.form-control:focus {
    outline: none;
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 2px hsl(var(--primary) / 0.2);
}

.form-control[rows] {
    resize: vertical;
    min-height: 100px;
}

.roles-container {
    position: relative;
}

.roles-select {
    min-height: 120px;
    background: hsl(var(--input));
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    padding: 0.5rem;
    color: hsl(var(--foreground));
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
}

.roles-select:focus {
    outline: none;
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 2px hsl(var(--primary) / 0.2);
}

.roles-select option {
    background: hsl(var(--input));
    color: hsl(var(--foreground));
    padding: 0.5rem;
}

.roles-info {
    margin-top: 0.5rem;
}

.roles-info small {
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
}

.form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 2rem;
    border-top: 1px solid hsl(var(--border));
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }
}
</style>
{% endblock %}
