{% extends 'base.html.twig' %}

{% block title %}GameHub - Your Gaming Community{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden hero-gradient">
    <!-- Noise Texture Overlay -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 /%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22 /%3E%3C/svg%3E');"></div>
    
    <!-- Particles Background -->
    <div class="particles-bg-home">
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
        <div class="particle-home"></div>
    </div>
    
    <!-- Grid Pattern Overlay -->
    <div class="absolute inset-0 grid-pattern opacity-50" data-parallax="0.3"></div>
    
    <!-- Animated Gradient Orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/30 rounded-full blur-3xl animate-pulse-slow" data-parallax="0.5"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary/30 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: -3s;" data-parallax="0.4"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-primary/20 to-secondary/20 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: -1.5s;"></div>
    
    <!-- Floating Game Cards - Left Side -->
    <div class="hidden lg:block absolute top-20 left-10 w-40 h-56 animate-float-cards" style="animation-delay: 0s;" data-parallax="0.2">
        <a href="{{ featuredGames|length > 0 ? path('game_show', {id: featuredGames[0].id}) : '#' }}" class="group block h-full" >
            <div class="card-gaming overflow-hidden h-full rounded-xl shadow-2xl neon-glow-strong group-hover:scale-110 group-hover:rotate-2 transition-all duration-500" data-tilt="8">
                {% if featuredGames|length > 0 %}
                    {% if featuredGames[0].coverImage %}
                        <img src="{{ asset(featuredGames[0].coverImage) }}" alt="{{ featuredGames[0].title }}" class="w-full h-full object-cover group-hover:scale-125 transition-transform duration-500" />
                    {% else %}
                        <div class="w-full h-full bg-muted flex items-center justify-center text-4xl">🎮</div>
                    {% endif %}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                        <div class="text-white font-orbitron text-xs font-bold line-clamp-2">{{ featuredGames[0].title }}</div>
                    </div>
                {% endif %}
            </div>
        </a>
    </div>

    <!-- Floating Game Cards - Top Right -->
    <div class="hidden lg:block absolute top-32 right-16 w-48 h-64 animate-float-cards" style="animation-delay: -2s;" data-parallax="0.25">
        <a href="{{ featuredGames|length > 1 ? path('game_show', {id: featuredGames[1].id}) : '#' }}" class="group block h-full" >
            <div class="card-gaming overflow-hidden h-full rounded-xl shadow-2xl neon-glow-purple-strong group-hover:scale-110 group-hover:-rotate-2 transition-all duration-500" data-tilt="8">
                {% if featuredGames|length > 1 %}
                    {% if featuredGames[1].coverImage %}
                        <img src="{{ asset(featuredGames[1].coverImage) }}" alt="{{ featuredGames[1].title }}" class="w-full h-full object-cover group-hover:scale-125 transition-transform duration-500" />
                    {% else %}
                        <div class="w-full h-full bg-muted flex items-center justify-center text-4xl">🎮</div>
                    {% endif %}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                        <div class="text-white font-orbitron text-xs font-bold line-clamp-2">{{ featuredGames[1].title }}</div>
                    </div>
                {% endif %}
            </div>
        </a>
    </div>

    <!-- Floating Game Cards - Bottom Left -->
    <div class="hidden lg:block absolute bottom-32 left-20 w-44 h-60 animate-float-cards" style="animation-delay: -4s;" data-parallax="0.15">
        <a href="{{ featuredGames|length > 2 ? path('game_show', {id: featuredGames[2].id}) : '#' }}" class="group block h-full" >
            <div class="card-gaming overflow-hidden h-full rounded-xl shadow-2xl neon-glow-strong group-hover:scale-110 group-hover:rotate-1 transition-all duration-500" data-tilt="8">
                {% if featuredGames|length > 2 %}
                    {% if featuredGames[2].coverImage %}
                        <img src="{{ asset(featuredGames[2].coverImage) }}" alt="{{ featuredGames[2].title }}" class="w-full h-full object-cover group-hover:scale-125 transition-transform duration-500" />
                    {% else %}
                        <div class="w-full h-full bg-muted flex items-center justify-center text-4xl">🎮</div>
                    {% endif %}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                        <div class="text-white font-orbitron text-xs font-bold line-clamp-2">{{ featuredGames[2].title }}</div>
                    </div>
                {% endif %}
            </div>
        </a>
    </div>

    <!-- Floating Game Cards - Bottom Right -->
    <div class="hidden lg:block absolute bottom-40 right-10 w-40 h-56 animate-float-cards" style="animation-delay: -3s;" data-parallax="0.2">
        <a href="{{ featuredGames|length > 3 ? path('game_show', {id: featuredGames[3].id}) : '#' }}" class="group block h-full" >
            <div class="card-gaming overflow-hidden h-full rounded-xl shadow-2xl neon-glow-purple-strong group-hover:scale-110 group-hover:-rotate-1 transition-all duration-500" data-tilt="8">
                {% if featuredGames|length > 3 %}
                    {% if featuredGames[3].coverImage %}
                        <img src="{{ asset(featuredGames[3].coverImage) }}" alt="{{ featuredGames[3].title }}" class="w-full h-full object-cover group-hover:scale-125 transition-transform duration-500" />
                    {% else %}
                        <div class="w-full h-full bg-muted flex items-center justify-center text-4xl">🎮</div>
                    {% endif %}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                        <div class="text-white font-orbitron text-xs font-bold line-clamp-2">{{ featuredGames[3].title }}</div>
                    </div>
                {% endif %}
            </div>
        </a>
    </div>
    
    <!-- Content -->
    <div class="container mx-auto px-4 pt-20 lg:pt-0 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Main Heading -->
            <h1 class="font-orbitron text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight animate-fade-in hero-heading-glow" style="animation-delay: 0.1s;" data-reveal>
                <span class="text-foreground drop-shadow-lg">Your Gateway to</span>
                <br />
                <span class="text-gradient text-glow-strong">Epic Gaming</span>
            </h1>
            
            <!-- Subtitle -->
            <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 animate-fade-in" style="animation-delay: 0.2s;">
                Discover thousands of DRM-free games, join epic gaming events, and connect with a passionate community of gamers worldwide.
            </p>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in" style="animation-delay: 0.3s;">
                <a href="{{ path('game_index') }}" class="btn-hero flex items-center gap-2 group hover:shadow-2xl hover:shadow-primary/30 hover:scale-105 transition-all">
                    Explore Games
                    <i class="fas fa-chevron-right w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                </a>
                <a href="https://youtu.be/dQw4w9WgXcQ?si=czrFcRRwpZzo-Ubw" target="_blank" rel="noopener noreferrer">
                <button class="btn-hero-outline flex items-center gap-2 hover:shadow-xl hover:shadow-primary/20 hover:scale-105 transition-all group">
                    <i class="fas fa-play w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    Watch Trailer
                </button>
                </a>
            </div>
            
            <!-- Stats Preview -->
            <div class="grid grid-cols-3 gap-8 mt-16 max-w-xl mx-auto animate-fade-in" style="animation-delay: 0.4s;">
                <div class="text-center group cursor-default">
                    <div class="font-orbitron text-2xl md:text-3xl font-bold text-gradient text-glow group-hover:scale-110 transition-transform">{{ totalGames }}</div>
                    <div class="text-sm text-muted-foreground uppercase tracking-wider mt-1">Games</div>
                </div>
                <div class="text-center group cursor-default">
                    <div class="font-orbitron text-2xl md:text-3xl font-bold text-gradient text-glow group-hover:scale-110 transition-transform">{{ totalEvents }}</div>
                    <div class="text-sm text-muted-foreground uppercase tracking-wider mt-1">Events</div>
                </div>
                <div class="text-center group cursor-default">
                    <div class="font-orbitron text-2xl md:text-3xl font-bold text-gradient text-glow group-hover:scale-110 transition-transform">∞</div>
                    <div class="text-sm text-muted-foreground uppercase tracking-wider mt-1">Freedom</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Bottom Gradient Fade -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent"></div>
</section>

<!-- Featured Games Section -->
<section class="py-20 lg:py-32 bg-background relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/5 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
            <div>
                <h2 class="font-orbitron text-3xl md:text-4xl font-bold mb-3">
                    <span class="text-gradient text-glow">Featured</span>
                    <span class="text-foreground"> Games</span>
                </h2>
                <p class="text-muted-foreground max-w-md">
                    Handpicked titles that define the gaming experience. Updated weekly with the best releases.
                </p>
            </div>
            <a href="{{ path('game_index') }}" class="btn-gaming group hover:shadow-lg hover:shadow-primary/20 hover:scale-105 transition-all">
                View All Games
                <i class="fas fa-chevron-right w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
        
        <!-- Games Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% for game in featuredGames %}
                <a href="{{ path('game_show', {id: game.id}) }}" class="group animate-fade-in" style="animation-delay: {{ loop.index0 * 0.1 }}s;" >
                    <div class="card-gaming overflow-hidden h-full hover:shadow-2xl hover:shadow-primary/20 hover:-translate-y-2 transition-all duration-300" data-tilt="5" data-reveal>
                        <!-- Image -->
                        <div class="relative aspect-[3/4] overflow-hidden">
                            {% if game.coverImage %}
                                <img src="{{ asset(game.coverImage) }}" alt="{{ game.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                            {% else %}
                                <div class="w-full h-full bg-muted flex items-center justify-center">
                                    <i class="fas fa-gamepad text-muted-foreground w-12 h-12"></i>
                                </div>
                            {% endif %}
                            
                            <!-- Overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent"></div>
                            
                            <!-- Price -->
                            <div class="absolute bottom-4 right-4 px-3 py-2 rounded-lg {% if game.price == 0 %}bg-primary/90 shadow-lg shadow-primary/50{% else %}bg-background/90{% endif %} backdrop-blur-sm border border-border/50">
                                <span class="text-sm font-bold {% if game.price == 0 %}text-primary-foreground{% else %}text-foreground{% endif %}">
                                    {% if game.price == 0 %}Free{% else %}${{ game.price }}{% endif %}
                                </span>
                            </div>
                        </div>
                        
                        <!-- Content -->
                        <div class="p-4">
                            <div class="text-xs text-primary uppercase tracking-wider mb-1">
                                {{ game.category }}
                            </div>
                            <h3 class="font-orbitron text-lg font-semibold text-foreground group-hover:text-primary transition-colors mb-2">
                                {{ game.title }}
                            </h3>
                            <div class="flex items-center gap-1">
                                <i class="fas fa-star text-yellow-500 fill-yellow-500"></i>
                                <span class="text-sm text-foreground">4.8</span>
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Upcoming Events Section -->
<section class="py-20 lg:py-32 bg-card relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 grid-pattern opacity-30"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
            <div>
                <h2 class="font-orbitron text-3xl md:text-4xl font-bold mb-3">
                    <span class="text-foreground">Upcoming </span>
                    <span class="text-gradient text-glow">Events</span>
                </h2>
                <p class="text-muted-foreground max-w-md">
                    Compete, collaborate, and celebrate gaming with our community events.
                </p>
            </div>
            <a href="{{ path('event_index') }}" class="btn-gaming group hover:shadow-lg hover:shadow-secondary/20 hover:scale-105 transition-all">
                View All Events
                <i class="fas fa-chevron-right w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
        
        <!-- Events Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {% for event in featuredEvents %}
                <div class="card-gaming overflow-hidden group animate-fade-in hover:shadow-2xl hover:shadow-secondary/20 hover:-translate-y-2 transition-all duration-300" style="animation-delay: {{ loop.index0 * 0.1 }}s;">
                    <!-- Image -->
                    <div class="relative h-48 overflow-hidden">
                        {% if event.game.coverImage %}
                            <img src="{{ asset(event.game.coverImage) }}" alt="{{ event.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                        {% else %}
                            <div class="w-full h-full bg-muted flex items-center justify-center">
                                <i class="fas fa-calendar text-muted-foreground w-12 h-12"></i>
                            </div>
                        {% endif %}
                        <div class="absolute inset-0 bg-gradient-to-t from-card via-card/50 to-transparent"></div>
                    </div>
                    
                    <!-- Content -->
                    <div class="p-6">
                        <div class="text-xs text-primary uppercase tracking-wider mb-2">
                            {{ event.game.title }}
                        </div>
                        <h3 class="font-orbitron text-xl font-semibold text-foreground group-hover:text-primary transition-colors mb-4">
                            {{ event.title }}
                        </h3>
                        
                        <!-- Event Details -->
                        <div class="space-y-2 mb-6">
                            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                                <i class="fas fa-calendar w-4 h-4 text-primary"></i>
                                <span>{{ event.date|date('M j, Y') }}</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                                <i class="fas fa-clock w-4 h-4 text-primary"></i>
                                <span>{{ event.date|date('g:i A') }}</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                                <i class="fas fa-users w-4 h-4 text-primary"></i>
                                <span>{{ event.maxPlayers }} Players</span>
                            </div>
                        </div>
                        
                        <a href="{{ path('event_show', {id: event.id}) }}" class="btn-gaming w-full text-center">
                            Learn More
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-20 lg:py-32 bg-background relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <!-- Header -->
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="font-orbitron text-3xl md:text-4xl font-bold mb-4">
                <span class="text-foreground">Why Choose </span>
                <span class="text-gradient text-glow">GameHub?</span>
            </h2>
            <p class="text-muted-foreground text-lg">
                Built by gamers, for gamers. Experience the difference with features designed around what matters most.
            </p>
        </div>
        
        <!-- Features Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            <div class="group p-6 lg:p-8 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-300 animate-fade-in" style="animation-delay: 0s;">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all">
                    <i class="fas fa-shield w-7 h-7 text-primary group-hover:drop-shadow-glow"></i>
                </div>
                <h3 class="font-orbitron text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors">
                    DRM-Free Gaming
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                    Own your games forever. No online checks, no restrictions. Play anywhere, anytime.
                </p>
            </div>
            
            <div class="group p-6 lg:p-8 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-300 animate-fade-in" style="animation-delay: 0.1s;">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all">
                    <i class="fas fa-users w-7 h-7 text-primary group-hover:drop-shadow-glow"></i>
                </div>
                <h3 class="font-orbitron text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors">
                    Vibrant Community
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                    Connect with millions of gamers. Share experiences, strategies, and make lasting friendships.
                </p>
            </div>
            
            <div class="group p-6 lg:p-8 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-300 animate-fade-in" style="animation-delay: 0.2s;">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all">
                    <i class="fas fa-calendar w-7 h-7 text-primary group-hover:drop-shadow-glow"></i>
                </div>
                <h3 class="font-orbitron text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors">
                    Epic Events
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                    From tournaments to community nights, there's always something exciting happening.
                </p>
            </div>
            
            <div class="group p-6 lg:p-8 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-300 animate-fade-in" style="animation-delay: 0.3s;">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all">
                    <i class="fas fa-download w-7 h-7 text-primary group-hover:drop-shadow-glow"></i>
                </div>
                <h3 class="font-orbitron text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors">
                    Instant Access
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                    Download and play immediately. No waiting, no queues, just pure gaming.
                </p>
            </div>
            
            <div class="group p-6 lg:p-8 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-300 animate-fade-in" style="animation-delay: 0.4s;">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all">
                    <i class="fas fa-trophy w-7 h-7 text-primary group-hover:drop-shadow-glow"></i>
                </div>
                <h3 class="font-orbitron text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors">
                    Rewards & Recognition
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                    Earn badges, achievements, and recognition for your gaming accomplishments.
                </p>
            </div>
            
            <div class="group p-6 lg:p-8 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-300 animate-fade-in" style="animation-delay: 0.5s;">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 group-hover:scale-110 transition-all">
                    <i class="fas fa-heart w-7 h-7 text-primary group-hover:drop-shadow-glow"></i>
                </div>
                <h3 class="font-orbitron text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors">
                    Player-First Philosophy
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                    Your gaming experience comes first. We listen and continuously improve based on feedback.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-20 lg:py-32 bg-gradient-to-r from-primary/10 via-background to-secondary/10 relative overflow-hidden">
    <div class="absolute top-1/2 right-0 -translate-y-1/2 w-96 h-96 bg-secondary/30 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-primary/20 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: -3s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="text-center max-w-3xl mx-auto">
            <h2 class="font-orbitron text-4xl md:text-5xl font-bold mb-6 text-gradient text-glow">
                Ready to Level Up?
            </h2>
            <p class="text-lg text-muted-foreground mb-10">
                Join thousands of gamers and start your adventure with GameHub today.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
