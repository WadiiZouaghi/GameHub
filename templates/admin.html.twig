<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}GameHub Admin{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚙️</text></svg>">
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --background: 228 60% 6%;
            --foreground: 210 40% 98%;
            --card: 228 50% 10%;
            --card-foreground: 210 40% 98%;
            --popover: 228 50% 10%;
            --popover-foreground: 210 40% 98%;
            --primary: 195 100% 45%;
            --primary-foreground: 228 60% 6%;
            --secondary: 282 68% 38%;
            --secondary-foreground: 210 40% 98%;
            --muted: 228 40% 15%;
            --muted-foreground: 215 20% 65%;
            --accent: 282 68% 38%;
            --accent-foreground: 210 40% 98%;
            --destructive: 0 84% 60%;
            --destructive-foreground: 210 40% 98%;
            --border: 228 30% 20%;
            --input: 228 30% 20%;
            --ring: 195 100% 45%;
            --radius: 0.75rem;
            --neon-cyan: 195 100% 45%;
            --neon-purple: 282 68% 38%;
            --neon-pink: 330 80% 55%;
            --dark-navy: 228 60% 6%;
            --dark-card: 228 50% 10%;
            --dark-elevated: 228 45% 14%;
        }

        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: hsl(var(--background));
            color: hsl(var(--foreground));
            font-family: 'Rajdhani', sans-serif;
            overflow: hidden;
        }

        .admin-wrapper {
            display: flex;
            height: 100vh;
        }

        .admin-layout {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .admin-main-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        .admin-main {
            flex: 1;
            overflow-y: auto;
            background-color: hsl(var(--background));
        }

        .admin-main::-webkit-scrollbar {
            width: 8px;
        }

        .admin-main::-webkit-scrollbar-track {
            background: hsl(var(--muted));
        }

        .admin-main::-webkit-scrollbar-thumb {
            background: hsl(var(--muted-foreground));
            border-radius: 4px;
        }

        .admin-main::-webkit-scrollbar-thumb:hover {
            background: hsl(var(--foreground));
        }

        .admin-main-content {
            padding: 1.5rem;
            max-width: 1600px;
            margin: 0 auto;
            width: 100%;
        }

        /* Minimal Gaming Sidebar */
        .admin-sidebar-nav {
            width: 240px;
            background: hsl(var(--card));
            border-right: 1px solid hsl(var(--border));
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 1.5rem 0;
        }

        .admin-sidebar-nav::-webkit-scrollbar {
            width: 4px;
        }

        .admin-sidebar-nav::-webkit-scrollbar-thumb {
            background: hsl(var(--muted-foreground));
            border-radius: 2px;
        }

        .admin-sidebar-header {
            padding: 0 1rem 1.5rem;
            border-bottom: 1px solid hsl(var(--border));
            margin-bottom: 1rem;
        }

        .admin-sidebar-header h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            color: hsl(var(--primary));
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .admin-sidebar-menu {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .sidebar-section {
            margin-bottom: 1.5rem;
        }

        .sidebar-section-title {
            padding: 0.5rem 1rem;
            font-size: 0.7rem;
            font-weight: 500;
            color: hsl(var(--muted-foreground));
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .admin-menu-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            color: hsl(var(--muted-foreground));
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            margin: 0 0.5rem;
            border-radius: 0.5rem;
            font-size: 0.9rem;
            font-family: 'Rajdhani', sans-serif;
        }

        .admin-menu-item:hover {
            color: hsl(var(--foreground));
            background: hsl(var(--muted));
            border-left-color: hsl(var(--primary));
        }

        .admin-menu-item.active {
            color: hsl(var(--foreground));
            background: hsl(var(--muted));
            border-left-color: hsl(var(--primary));
            box-shadow: 0 0 15px hsl(var(--primary) / 0.2);
        }

        .admin-menu-item i {
            font-size: 1rem;
            min-width: 1.2rem;
            text-align: center;
        }

        .admin-sidebar-footer {
            padding: 1rem;
            border-top: 1px solid hsl(var(--border));
            margin-top: auto;
        }

        .admin-sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0;
            color: hsl(var(--muted-foreground));
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 0.85rem;
            font-family: 'Rajdhani', sans-serif;
        }

        .admin-sidebar-footer a:hover {
            color: hsl(var(--primary));
        }

        /* Minimal Gaming Topbar */
        .admin-topbar {
            background: hsl(var(--card));
            border-bottom: 1px solid hsl(var(--border));
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            box-shadow: 0 2px 10px hsl(var(--background) / 0.5);
        }

        .admin-topbar-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .admin-topbar-left h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: hsl(var(--primary));
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .admin-topbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .admin-search {
            position: relative;
        }

        .admin-search input {
            background: hsl(var(--input));
            border: 1px solid hsl(var(--border));
            border-radius: 0.5rem;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            color: hsl(var(--foreground));
            width: 280px;
            font-size: 0.9rem;
            font-family: 'Rajdhani', sans-serif;
            transition: all 0.3s ease;
        }

        .admin-search input:focus {
            outline: none;
            border-color: hsl(var(--primary));
            box-shadow: 0 0 0 2px hsl(var(--primary) / 0.2);
        }

        .admin-search i {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: hsl(var(--muted-foreground));
        }

        .admin-notifications {
            position: relative;
            padding: 0.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

        .admin-notifications:hover {
            background: hsl(var(--muted));
        }

        .admin-notifications i {
            color: hsl(var(--muted-foreground));
            font-size: 1.1rem;
        }

        .admin-user-menu {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .admin-user-menu:hover {
            background: hsl(var(--muted));
        }

        .admin-user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: hsl(var(--muted));
            display: flex;
            align-items: center;
            justify-content: center;
            color: hsl(var(--foreground));
            font-weight: 600;
        }

        .admin-user-info {
            display: flex;
            flex-direction: column;
        }

        .admin-user-name {
            font-size: 0.9rem;
            font-weight: 500;
            color: hsl(var(--foreground));
        }

        .admin-user-role {
            font-size: 0.8rem;
            color: hsl(var(--muted-foreground));
        }

        /* Compact KPI Cards */
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--dark-elevated)) 100%);
            border: 1px solid hsl(var(--border));
            border-radius: 0.5rem;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            color: hsl(var(--card-foreground));
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--secondary)));
        }

        .stat-card:hover {
            border-color: hsl(var(--primary));
            box-shadow: 0 4px 15px hsl(var(--primary) / 0.15);
            transform: translateY(-2px);
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            background: hsl(var(--muted));
            border: 1px solid hsl(var(--border));
            border-radius: 0.4rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: hsl(var(--primary));
            font-size: 1.2rem;
            position: relative;
            z-index: 1;
            flex-shrink: 0;
        }

        .stat-content h3 {
            margin: 0 0 0.2rem 0;
            font-size: 1.75rem;
            color: hsl(var(--foreground));
            font-weight: 700;
            font-family: 'Orbitron', sans-serif;
            position: relative;
            z-index: 1;
        }

        .stat-content p {
            margin: 0 0 0.25rem 0;
            color: hsl(var(--muted-foreground));
            font-size: 0.8rem;
            position: relative;
            z-index: 1;
        }

        .stat-change {
            font-size: 0.7rem;
            color: hsl(var(--primary));
            font-weight: 600;
            position: relative;
            z-index: 1;
        }

        .stat-change.negative {
            color: hsl(var(--destructive));
        }

        /* Compact Sections */
        .admin-section {
            background: hsl(var(--card));
            border: 1px solid hsl(var(--border));
            border-radius: var(--radius);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            color: hsl(var(--card-foreground));
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid hsl(var(--border));
        }

        .section-header h2 {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Orbitron', sans-serif;
            font-weight: 600;
            color: hsl(var(--foreground));
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Minimal Gaming Tables */
        .admin-table {
            overflow-x: auto;
            border-radius: var(--radius);
            border: 1px solid hsl(var(--border));
        }

        .admin-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .admin-table thead {
            background: hsl(var(--muted));
        }

        .admin-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            color: hsl(var(--foreground));
            font-weight: 600;
            font-family: 'Rajdhani', sans-serif;
            border-bottom: 1px solid hsl(var(--border));
            font-size: 0.9rem;
        }

        .admin-table td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid hsl(var(--border));
            color: hsl(var(--muted-foreground));
            font-size: 0.9rem;
        }

        .admin-table tbody tr:nth-child(even) {
            background: hsl(var(--muted) / 0.3);
        }

        .admin-table tbody tr:hover {
            background: hsl(var(--muted));
        }

        /* Minimal Empty States */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: hsl(var(--muted-foreground));
        }

        .empty-state i {
            display: block;
            margin-bottom: 1rem;
            color: hsl(var(--muted-foreground));
            font-size: 3rem;
        }

        .empty-state h3 {
            margin-bottom: 0.5rem;
            color: hsl(var(--foreground));
        }

        /* Minimal Gaming Badges */
        .badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-family: 'Rajdhani', sans-serif;
        }

        .badge-published {
            background: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
        }

        .badge-draft {
            background: hsl(var(--muted));
            color: hsl(var(--muted-foreground));
        }

        .badge-archived {
            background: hsl(var(--destructive));
            color: hsl(var(--destructive-foreground));
        }

        .badge-success {
            background: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
        }

        .badge-warning {
            background: hsl(var(--secondary));
            color: hsl(var(--secondary-foreground));
        }

        .badge-danger {
            background: hsl(var(--destructive));
            color: hsl(var(--destructive-foreground));
        }

        /* Minimal Gaming Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            text-decoration: none;
            font-weight: 600;
            font-family: 'Rajdhani', sans-serif;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .btn-primary {
            background: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
            border-color: hsl(var(--primary));
        }

        .btn-primary:hover {
            background: hsl(var(--primary) / 0.8);
            border-color: hsl(var(--primary) / 0.8);
            box-shadow: 0 0 15px hsl(var(--primary) / 0.3);
        }

        .btn-secondary {
            background: transparent;
            color: hsl(var(--foreground));
            border-color: hsl(var(--border));
        }

        .btn-secondary:hover {
            background: hsl(var(--muted));
            border-color: hsl(var(--foreground));
        }

        .btn-small {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .btn-danger {
            background: hsl(var(--destructive));
            color: hsl(var(--destructive-foreground));
            border-color: hsl(var(--destructive));
        }

        .btn-danger:hover {
            background: hsl(var(--destructive) / 0.8);
            border-color: hsl(var(--destructive) / 0.8);
        }

        /* Admin Select */
        .admin-select {
            background: hsl(var(--input));
            border: 1px solid hsl(var(--border));
            border-radius: 0.5rem;
            padding: 0.5rem 1rem;
            color: hsl(var(--foreground));
            font-size: 0.9rem;
            font-family: 'Rajdhani', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .admin-select:focus {
            outline: none;
            border-color: hsl(var(--primary));
            box-shadow: 0 0 0 2px hsl(var(--primary) / 0.2);
        }

        .admin-select option {
            background: hsl(var(--card));
            color: hsl(var(--foreground));
        }

        /* Compact Charts */
        .charts-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 0;
        }

        .chart-wrapper {
            background: linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--dark-elevated)) 100%);
            border: 1px solid hsl(var(--border));
            border-radius: 0.5rem;
            padding: 0.75rem;
            transition: all 0.3s ease;
        }

        .chart-wrapper:hover {
            border-color: hsl(var(--primary));
            box-shadow: 0 4px 15px hsl(var(--primary) / 0.1);
        }

        .chart-wrapper h3 {
            margin: 0 0 0.5rem 0;
            color: hsl(var(--foreground));
            font-size: 0.75rem;
            text-align: left;
            font-weight: 600;
            font-family: 'Orbitron', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .chart-wrapper h3 i {
            color: hsl(var(--primary));
            font-size: 0.75rem;
        }

        .chart-wrapper canvas {
            max-height: 80px !important;
        }

        /* Alert Messages */
        .alert {
            padding: 1rem 1.5rem;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.95rem;
            border: 1px solid;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            background: hsl(var(--primary) / 0.1);
            border-color: hsl(var(--primary) / 0.3);
            color: hsl(var(--primary));
        }

        .alert-error, .alert-danger {
            background: hsl(var(--destructive) / 0.1);
            border-color: hsl(var(--destructive) / 0.3);
            color: hsl(var(--destructive));
        }

        .alert-warning {
            background: hsl(var(--secondary) / 0.1);
            border-color: hsl(var(--secondary) / 0.3);
            color: hsl(var(--secondary));
        }

        .alert-info {
            background: hsl(var(--muted));
            border-color: hsl(var(--border));
            color: hsl(var(--foreground));
        }

        .alert i {
            font-size: 1.2rem;
        }

        .mb-4 {
            margin-bottom: 1.5rem;
        }

        /* User Cell */
        .user-cell {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
        }

        .user-avatar.small {
            width: 32px;
            height: 32px;
        }

        .user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar-placeholder {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: hsl(var(--primary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: hsl(var(--primary-foreground));
            font-weight: 600;
            font-family: 'Orbitron', sans-serif;
        }

        .avatar-placeholder.small {
            width: 32px;
            height: 32px;
            font-size: 0.85rem;
        }

        /* Stats Filters */
        .stats-filters {
            display: flex;
            gap: 0.5rem;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .admin-sidebar-nav {
                width: 200px;
            }

            .admin-stats {
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            }
        }

        @media (max-width: 768px) {
            .admin-topbar {
                padding: 1rem;
            }

            .admin-search input {
                width: 200px;
            }

            .admin-stats {
                grid-template-columns: 1fr;
            }

            .charts-container {
                grid-template-columns: 1fr;
            }

            .admin-main-content {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <div class="admin-layout">
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <h1>GameHub Admin</h1>
                </div>
                <div class="admin-topbar-right">
                    <div class="admin-search">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search...">
                    </div>
                    <div class="admin-notifications">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div class="admin-user-menu">
                        <div class="admin-user-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="admin-user-info">
                            <div class="admin-user-name">{{ app.user.username ?? 'Admin' }}</div>
                            <div class="admin-user-role">Administrator</div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="admin-main-wrapper">
                <aside class="admin-sidebar-nav">
                    <div class="admin-sidebar-header">
                        <h2>GameHub Admin</h2>
                    </div>
                    <nav class="admin-sidebar-menu">
                        <div class="sidebar-section">
                            <div class="sidebar-section-title">MAIN</div>
                            <a href="{{ path('admin_dashboard') }}" class="admin-menu-item {% if app.request.get('_route') == 'admin_dashboard' %}active{% endif %}">
                                <i class="fas fa-tachometer-alt"></i>
                                Dashboard
                            </a>
                            <a href="{{ path('admin_games') }}" class="admin-menu-item {% if app.request.get('_route') starts with 'admin_games' %}active{% endif %}">
                                <i class="fas fa-gamepad"></i>
                                Games
                            </a>
                            <a href="{{ path('admin_users') }}" class="admin-menu-item {% if app.request.get('_route') starts with 'admin_users' %}active{% endif %}">
                                <i class="fas fa-users"></i>
                                Users
                            </a>
                            <a href="{{ path('admin_events') }}" class="admin-menu-item {% if app.request.get('_route') starts with 'admin_events' %}active{% endif %}">
                                <i class="fas fa-calendar-alt"></i>
                                Events
                            </a>
                            <a href="{{ path('admin_reviews') }}" class="admin-menu-item {% if app.request.get('_route') starts with 'admin_reviews' %}active{% endif %}">
                                <i class="fas fa-star"></i>
                                Reviews
                            </a>
                        </div>

                        <div class="sidebar-section">
                            <a href="{{ path('app_home') }}" class="admin-menu-item">
                                <i class="fas fa-home"></i>
                                Back to Site
                            </a>
                            <a href="{{ path('app_logout') }}" class="admin-menu-item">
                                <i class="fas fa-sign-out-alt"></i>
                                Logout
                            </a>
                        </div>
                    </nav>
                </aside>

                <main class="admin-main">
                    <div class="admin-main-content">
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label }} mb-4">
                                    <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'error' or label == 'danger' ? 'exclamation-circle' : 'info-circle') }}"></i>
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endfor %}

                        {% block content %}{% endblock %}
                    </div>
                </main>
            </div>
        </div>
    </div>
</body>
</html>
