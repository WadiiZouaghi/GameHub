{% extends 'base.html.twig' %}

{% block title %}Games - GameHub{% endblock %}

{% block body %}
<div class="container mx-auto px-4 pt-24 pb-20">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
            <h1 class="font-orbitron text-4xl md:text-5xl font-bold mb-3">
                <span class="text-foreground">Game</span>
                <span class="text-gradient">Catalogue</span>
            </h1>
            <p class="text-muted-foreground max-w-md">
                Discover and explore our amazing collection of DRM-free games
            </p>
        </div>

        {% if app.user %}
            <a href="{{ path('game_new') }}" class="btn-hero flex items-center gap-2 group w-fit">
                <i class="fas fa-plus"></i>
                Add New Game
            </a>
        {% endif %}
    </div>

    <!-- Filters -->
    <div class="card-gaming p-6 mb-12 animate-fade-in">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label for="category-filter" class="block text-sm font-orbitron font-semibold text-foreground mb-2">
                    <i class="fas fa-filter text-primary mr-2"></i>Filter by Category
                </label>
                <select id="category-filter" class="w-full bg-muted border border-border rounded-lg px-4 py-2 text-foreground font-rajdhani focus:outline-none focus:border-primary">
                    <option value="">All Categories</option>
                    {% for category in categories %}
                        <option value="{{ category }}" {% if selected_category == category %}selected{% endif %}>{{ category }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="search-input" class="block text-sm font-orbitron font-semibold text-foreground mb-2">
                    <i class="fas fa-search text-primary mr-2"></i>Search Games
                </label>
                <input type="text" id="search-input" value="{{ search_query|default('') }}" class="w-full bg-muted border border-border rounded-lg px-4 py-2 text-foreground font-rajdhani placeholder-muted-foreground focus:outline-none focus:border-primary" placeholder="Search by title...">
            </div>

            <div>
                <label for="sort-select" class="block text-sm font-orbitron font-semibold text-foreground mb-2">
                    <i class="fas fa-sort text-primary mr-2"></i>Sort By
                </label>
                <select id="sort-select" class="w-full bg-muted border border-border rounded-lg px-4 py-2 text-foreground font-rajdhani focus:outline-none focus:border-primary">
                    <option value="title_asc" {% if selected_sort == 'title_asc' %}selected{% endif %}>Title (A-Z)</option>
                    <option value="title_desc" {% if selected_sort == 'title_desc' %}selected{% endif %}>Title (Z-A)</option>
                    <option value="newest" {% if selected_sort == 'newest' %}selected{% endif %}>Newest</option>
                    <option value="oldest" {% if selected_sort == 'oldest' %}selected{% endif %}>Oldest</option>
                    <option value="category" {% if selected_sort == 'category' %}selected{% endif %}>Category</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Games Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {% for game in games %}
            <div class="game-card group" 
                 data-game-id="{{ game.id }}"
                 {% if game.gallery and game.gallery|length > 0 %}
                 data-gallery='{{ game.gallery|json_encode }}'
                 {% endif %}>
                <a href="{{ path('game_show', {id: game.id}) }}" class="block bg-card rounded overflow-hidden hover:shadow-lg transition-shadow">
                    <div data-tilt="5" data-reveal>
                    <!-- Image Container -->
                    <div class="relative aspect-[16/9] overflow-hidden bg-muted">
                        {% if game.coverImage %}
                            <img src="{{ asset(game.coverImage) }}" 
                                 alt="{{ game.title }}" 
                                 class="game-main-image w-full h-full object-cover" />
                        {% else %}
                            <div class="w-full h-full bg-muted flex items-center justify-center">
                                <i class="fas fa-gamepad text-4xl text-muted-foreground/40"></i>
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- Content -->
                    <div class="p-3">
                        <h3 class="font-semibold text-foreground mb-1 truncate">
                            {{ game.title }}
                        </h3>
                        
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-muted-foreground text-xs">{{ game.category }}</span>
                            {% if game.price == 0 %}
                                <span class="text-green-500 font-semibold">Free</span>
                            {% else %}
                                <span class="text-foreground font-semibold">${{ game.price|number_format(2) }}</span>
                            {% endif %}
                        </div>
                    </div>
                    </div>
                </a>
            </div>
        {% else %}
            <div class="col-span-full flex flex-col items-center justify-center py-20 text-center">
                <i class="fas fa-gamepad text-5xl text-muted-foreground mb-4 opacity-50"></i>
                <h2 class="font-orbitron text-2xl font-bold text-foreground mb-2">No Games Available</h2>
                <p class="text-muted-foreground mb-6">There are no games in our catalogue yet. Check back later!</p>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_games_new') }}" class="btn-hero flex items-center gap-2">
                        <i class="fas fa-plus"></i>
                        Add First Game
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <!-- Load More Button (if many games) -->
    {% if games|length > 12 %}
        <div class="text-center mt-4">
            <button id="load-more" class="btn btn-secondary">
                <i class="fas fa-plus"></i>
                Load More Games
            </button>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const categoryFilter = document.getElementById('category-filter');
        const searchInput = document.getElementById('search-input');
        const sortSelect = document.getElementById('sort-select');

        function submitFilters() {
            const category = categoryFilter.value;
            const search = searchInput.value.trim();
            const sort = sortSelect.value;
            let url = new URL(window.location.href);
            url.searchParams.set('category', category);
            url.searchParams.set('search', search);
            url.searchParams.set('sort', sort);
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }

        categoryFilter.addEventListener('change', submitFilters);
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                submitFilters();
            }
        });
        sortSelect.addEventListener('change', submitFilters);

        // Gallery preview on hover (Steam-like)
        const gameCards = document.querySelectorAll('.game-card');
        
        gameCards.forEach(card => {
            const gallery = card.dataset.gallery;
            if (!gallery) return;
            
            let images = [];
            try {
                images = JSON.parse(gallery);
            } catch (e) {
                return;
            }
            
            if (images.length === 0) return;
            
            const imgElement = card.querySelector('.game-main-image');
            if (!imgElement) return;
            
            const originalSrc = imgElement.src;
            let currentIndex = 0;
            let interval = null;
            
            card.addEventListener('mouseenter', () => {
                if (images.length === 0) return;
                
                currentIndex = 0;
                interval = setInterval(() => {
                    currentIndex = (currentIndex + 1) % images.length;
                    const newSrc = '{{ asset('') }}' + images[currentIndex];
                    imgElement.src = newSrc;
                }, 800);
            });
            
            card.addEventListener('mouseleave', () => {
                if (interval) {
                    clearInterval(interval);
                    interval = null;
                }
                imgElement.src = originalSrc;
            });
        });
    });
</script>
{% endblock %}