{% extends 'base.html.twig' %}

{% block title %}Checkout - {{ game.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #card-container {
            min-height: 200px;
        }
        .checkout-gradient {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
        }
        .price-highlight {
            background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
{% endblock %}

{% set tax_rate = 0.10 %}
{% set subtotal = game.price %}
{% set tax_amount = subtotal * tax_rate %}
{% set total_amount = subtotal + tax_amount %}

{% block body %}
<div class="bg-gradient-to-b from-background via-background to-muted/30 min-h-screen">
    <div class="container mx-auto px-4 py-24">
        <div class="max-w-5xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-12">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 border-2 border-primary/20 mb-4">
                    <i class="fas fa-shopping-cart text-primary text-2xl"></i>
                </div>
                <h1 class="font-orbitron text-4xl lg:text-5xl font-bold text-foreground mb-4 text-gradient">Complete Your Purchase</h1>
                <p class="text-muted-foreground font-rajdhani text-lg">Fast, secure, and encrypted checkout</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Order Summary -->
                <div class="lg:col-span-2 space-y-6 order-2 lg:order-1">
                    <!-- Game Details Card -->
                    <div class="card-gaming p-8 rounded-xl">
                        <h2 class="font-orbitron text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
                            <i class="fas fa-gamepad text-primary"></i>
                            Your Order
                        </h2>
                        
                        <div class="flex gap-6 p-6 checkout-gradient rounded-xl border border-border/50">
                            {% if game.coverImage %}
                                <img src="{{ asset(game.coverImage) }}" alt="{{ game.title }}" class="w-32 h-44 object-cover rounded-lg shadow-xl border-2 border-primary/20">
                            {% else %}
                                <div class="w-32 h-44 bg-gradient-to-br from-primary/20 to-primary/5 rounded-lg flex items-center justify-center text-5xl border-2 border-primary/20">🎮</div>
                            {% endif %}
                            <div class="flex-1">
                                <h3 class="font-orbitron text-xl font-bold text-foreground mb-3">{{ game.title }}</h3>
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2 text-sm text-muted-foreground font-rajdhani">
                                        <i class="fas fa-tag text-primary"></i>
                                        <span>{{ game.category }}</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-sm text-muted-foreground font-rajdhani">
                                        <i class="fas fa-download text-primary"></i>
                                        <span>Digital Download</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-sm text-muted-foreground font-rajdhani">
                                        <i class="fas fa-infinity text-primary"></i>
                                        <span>Lifetime Access</span>
                                    </div>
                                </div>
                                <div class="mt-4 pt-4 border-t border-border/30">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm text-muted-foreground font-rajdhani">Quantity:</span>
                                        <span class="text-foreground font-semibold font-rajdhani">1</span>
                                        <span class="ml-auto text-lg font-bold text-foreground font-orbitron">${{ game.price|number_format(2) }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Form -->
                    <div class="card-gaming p-8 rounded-xl">
                        <h2 class="font-orbitron text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
                            <i class="fas fa-credit-card text-primary"></i>
                            Payment Method
                        </h2>

                        <form id="payment-form" class="space-y-6">
                            <div>
                                <label class="block text-sm font-semibold text-foreground mb-3 font-rajdhani">Card Information</label>
                                <div id="card-container" class="bg-background/50 border-2 border-border rounded-lg p-4 transition-all focus-within:border-primary/50"></div>
                                <div id="payment-status-container" class="mt-3"></div>
                            </div>

                            <div id="error-message" class="hidden bg-red-500/10 border border-red-500/50 text-red-400 px-4 py-3 rounded-lg text-sm font-rajdhani">
                                <i class="fas fa-exclamation-circle mr-2"></i>
                                <span id="error-text"></span>
                            </div>

                            <button type="submit" id="card-button" class="btn-hero w-full py-4 text-lg flex items-center justify-center gap-3 transition-all hover:scale-[1.02]">
                                <i class="fas fa-lock"></i>
                                <span>Pay ${{ total_amount|number_format(2) }}</span>
                            </button>

                            <div class="flex items-center justify-center gap-6 pt-2">
                                <div class="flex items-center gap-2 text-xs text-muted-foreground font-rajdhani">
                                    <i class="fas fa-shield-alt text-primary"></i>
                                    <span>256-bit SSL Encrypted</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs text-muted-foreground font-rajdhani">
                                    <i class="fas fa-lock text-primary"></i>
                                    <span>PCI DSS Compliant</span>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Price Summary Sidebar -->
                <div class="order-1 lg:order-2">
                    <div class="card-gaming p-6 rounded-xl sticky top-24">
                        <h3 class="font-orbitron text-lg font-bold text-foreground mb-4 flex items-center gap-2">
                            <i class="fas fa-receipt text-primary"></i>
                            Order Summary
                        </h3>
                        
                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between items-center font-rajdhani text-sm">
                                <span class="text-muted-foreground">Subtotal</span>
                                <span class="text-foreground font-semibold">${{ subtotal|number_format(2) }}</span>
                            </div>
                            <div class="flex justify-between items-center font-rajdhani text-sm">
                                <span class="text-muted-foreground">Tax ({{ (tax_rate * 100)|number_format(0) }}%)</span>
                                <span class="text-foreground font-semibold">${{ tax_amount|number_format(2) }}</span>
                            </div>
                            <div class="border-t border-border/50 pt-3 flex justify-between items-center">
                                <span class="font-orbitron text-base font-bold text-foreground">Total</span>
                                <span class="font-orbitron text-2xl font-bold price-highlight">${{ total_amount|number_format(2) }}</span>
                            </div>
                        </div>

                        <div class="bg-primary/5 border border-primary/20 rounded-lg p-4 space-y-2">
                            <div class="flex items-start gap-2 text-xs text-muted-foreground font-rajdhani">
                                <i class="fas fa-check-circle text-primary mt-0.5"></i>
                                <span>Instant access after purchase</span>
                            </div>
                            <div class="flex items-start gap-2 text-xs text-muted-foreground font-rajdhani">
                                <i class="fas fa-check-circle text-primary mt-0.5"></i>
                                <span>Full refund within 14 days</span>
                            </div>
                            <div class="flex items-start gap-2 text-xs text-muted-foreground font-rajdhani">
                                <i class="fas fa-check-circle text-primary mt-0.5"></i>
                                <span>24/7 customer support</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Back Link -->
            <div class="text-center mt-8">
                <a href="{{ path('game_show', {'id': game.id}) }}" class="text-muted-foreground hover:text-primary transition-colors font-rajdhani inline-flex items-center gap-2">
                    <i class="fas fa-arrow-left"></i>
                    Back to game
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="https://sandbox.web.squarecdn.com/v1/square.js"></script>
    <script>
        const gameId = {{ game.id }};
        const gamePrice = {{ total_amount }};
        const applicationId = '{{ square_application_id }}';
        const locationId = '{{ square_location_id }}';
    </script>
    <script src="{{ asset('js/checkout.js') }}"></script>
{% endblock %}
